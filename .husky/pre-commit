#!/bin/sh

# 🏠 Homely Pre-commit Hook
# =========================
# This hook runs before each commit to ensure code quality
# and family-friendly development standards

# Color codes for beautiful output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
  echo "${BLUE}ℹ️  [INFO]${NC} $1"
}

log_success() {
  echo "${GREEN}✅ [SUCCESS]${NC} $1"
}

log_warning() {
  echo "${YELLOW}⚠️  [WARNING]${NC} $1"
}

log_error() {
  echo "${RED}❌ [ERROR]${NC} $1"
}

log_header() {
  echo "${PURPLE}🏠 [HOMELY]${NC} $1"
}

# Start of pre-commit process
log_header "Starting pre-commit checks..."
echo "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Function to run command with error handling
run_check() {
  local check_name="$1"
  local command="$2"
  local description="$3"
  
  log_info "Running $check_name..."
  echo "  📋 $description"
  
  if eval "$command"; then
    log_success "$check_name passed"
    return 0
  else
    log_error "$check_name failed"
    return 1
  fi
}

# Track if any checks failed
checks_failed=0

# 1. Check for staged files
log_info "Checking for staged files..."
staged_files=$(git diff --cached --name-only)
if [ -z "$staged_files" ]; then
  log_warning "No staged files found. Nothing to check."
  exit 0
fi

log_info "Found staged files:"
echo "$staged_files" | while read -r file; do
  echo "  📄 $file"
done

# 2. Run lint-staged for code quality
if ! run_check "Lint Staged" "npx lint-staged" "Linting and formatting staged files"; then
  checks_failed=$((checks_failed + 1))
fi

# 3. Check for sensitive information
log_info "Scanning for sensitive information..."
sensitive_patterns=(
  "password\s*=\s*['\"][^'\"]+['\"]"
  "api_key\s*=\s*['\"][^'\"]+['\"]"
  "secret\s*=\s*['\"][^'\"]+['\"]"
  "token\s*=\s*['\"][^'\"]+['\"]"
  "-----BEGIN.*PRIVATE KEY-----"
)

for pattern in "${sensitive_patterns[@]}"; do
  if git diff --cached | grep -iE "$pattern" > /dev/null; then
    log_error "Potential sensitive information detected: $pattern"
    checks_failed=$((checks_failed + 1))
  fi
done

if [ $checks_failed -eq 0 ]; then
  log_success "No sensitive information detected"
fi

# 4. Check commit size
commit_size=$(git diff --cached --stat | tail -1 | grep -o '[0-9]\+ files\? changed' | grep -o '[0-9]\+' || echo "0")
if [ "$commit_size" -gt 50 ]; then
  log_warning "Large commit detected ($commit_size files). Consider breaking into smaller commits."
fi

# 5. Check for TODO/FIXME comments in staged files
log_info "Checking for TODO/FIXME comments..."
todo_count=0
git diff --cached --name-only | while read -r file; do
  if [ -f "$file" ]; then
    todos=$(git show :"$file" | grep -n -i "TODO\|FIXME" || true)
    if [ -n "$todos" ]; then
      echo "$todos" | while read -r todo; do
        log_warning "Found in $file: $todo"
        todo_count=$((todo_count + 1))
      done
    fi
  fi
done

# 6. Family-specific checks
log_info "Running family-specific checks..."

# Check for family-friendly variable names (excluding development terms)
if git diff --cached | grep -iE "(porn|sex|adult|xxx)" > /dev/null; then
  # Exclude false positives like "fixme", "todo", etc.
  if ! git diff --cached | grep -iE "(porn|sex|adult|xxx)" | grep -vE "(fixme|todo|debug|test)" > /dev/null; then
    log_error "Inappropriate content detected. This is a family-friendly project."
    checks_failed=$((checks_failed + 1))
  fi
fi

# Check TypeScript files for basic quality
ts_files=$(git diff --cached --name-only | grep '\.tsx\?$' || true)
if [ -n "$ts_files" ]; then
  log_info "Validating TypeScript files..."
  echo "$ts_files" | while read -r file; do
    if [ -f "$file" ]; then
      # Check for console.log statements (should use proper logging)
      console_logs=$(git show :"$file" | grep -n "console\.log" || true)
      if [ -n "$console_logs" ]; then
        log_warning "console.log found in $file. Consider using proper logging."
      fi
      
      # Check for any statements
      if git show :"$file" | grep -n ": any" > /dev/null; then
        log_warning "TypeScript 'any' type found in $file. Consider using specific types."
      fi
    fi
  done
fi

# Final result
echo "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

if [ $checks_failed -eq 0 ]; then
  log_success "All pre-commit checks passed! 🎉"
  log_header "Ready to commit to the family project! 👨‍👩‍👧‍👦"
  exit 0
else
  log_error "$checks_failed check(s) failed"
  log_header "Please fix the issues above before committing"
  echo ""
  log_info "💡 Tips:"
  echo "  • Run 'npm run lint' to fix linting issues"
  echo "  • Run 'npm run format' to format code"
  echo "  • Review sensitive information warnings"
  echo "  • Use 'git commit --no-verify' to bypass (not recommended)"
  exit 1
fi 