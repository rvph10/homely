#!/bin/sh

# 🏠 Homely Commit Message Hook
# ==============================
# This hook validates commit messages to ensure they follow
# family-friendly project conventions

# Color codes for beautiful output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
  echo "${BLUE}ℹ️  [INFO]${NC} $1"
}

log_success() {
  echo "${GREEN}✅ [SUCCESS]${NC} $1"
}

log_warning() {
  echo "${YELLOW}⚠️  [WARNING]${NC} $1"
}

log_error() {
  echo "${RED}❌ [ERROR]${NC} $1"
}

log_header() {
  echo "${PURPLE}🏠 [HOMELY]${NC} $1"
}

# Get commit message from file
commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Start validation
log_header "Validating commit message..."
echo "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

log_info "Commit message:"
echo "${CYAN}\"$commit_msg\"${NC}"

# Track validation errors
validation_errors=0

# 1. Check message length
msg_length=${#commit_msg}
log_info "Message length: $msg_length characters"

if [ $msg_length -lt 10 ]; then
  log_error "Commit message too short (minimum 10 characters)"
  validation_errors=$((validation_errors + 1))
elif [ $msg_length -gt 72 ]; then
  log_warning "Commit message is long ($msg_length chars). Consider keeping first line under 72 characters."
fi

# 2. Check for proper capitalization (allow conventional commits)
conventional_pattern="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?: .+"
if echo "$commit_msg" | grep -qE "$conventional_pattern"; then
  # Conventional commits are allowed to start with lowercase
  log_success "Conventional commit format - capitalization valid"
else
  first_char=$(echo "$commit_msg" | head -c 1)
  if ! echo "$first_char" | grep -q '[A-Z]'; then
    log_error "Commit message should start with a capital letter"
    validation_errors=$((validation_errors + 1))
  fi
fi

# 3. Check for trailing period
if echo "$commit_msg" | grep -q '\.$'; then
  log_warning "Commit message ends with period. Consider removing it for consistency."
fi

# 4. Family-friendly content check
inappropriate_words="fuck|shit|damn|hell|stupid|idiot|hate"
if echo "$commit_msg" | grep -iE "$inappropriate_words" > /dev/null; then
  log_error "Inappropriate language detected. This is a family-friendly project."
  validation_errors=$((validation_errors + 1))
fi

# 5. Check for conventional commit format (optional but recommended)
conventional_pattern="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?: .+"
if echo "$commit_msg" | grep -qE "$conventional_pattern"; then
  log_success "Follows conventional commit format"
else
  log_info "Consider using conventional commit format:"
  echo "  ${YELLOW}Examples:${NC}"
  echo "  • feat: add family calendar integration"
  echo "  • fix: resolve task assignment bug"
  echo "  • docs: update setup instructions"
  echo "  • refactor: improve database connection handling"
  echo "  • style: format code and fix linting issues"
fi

# 6. Check for specific Homely project conventions
homely_keywords="family|home|task|calendar|reminder|member|parent|child|privacy|security"
if echo "$commit_msg" | grep -iE "$homely_keywords" > /dev/null; then
  log_success "Contains family management context"
fi

# 7. Check for issue/ticket references
if echo "$commit_msg" | grep -iE "#[0-9]+|closes|fixes|resolves" > /dev/null; then
  log_success "References issue or ticket"
fi

# 8. Validate against common anti-patterns
anti_patterns=(
  "^wip[^a-zA-Z]|^WIP[^a-zA-Z]"
  "^temp[^a-zA-Z]|^TEMP[^a-zA-Z]"
  "^test[^a-zA-Z]|^TEST[^a-zA-Z]"
  "^debug[^a-zA-Z]|^DEBUG[^a-zA-Z]"
  "^quick[^a-zA-Z]|^QUICK[^a-zA-Z]"
  "asdf|qwerty|123456"
)

for pattern in "${anti_patterns[@]}"; do
  if echo "$commit_msg" | grep -qE "$pattern"; then
    log_error "Detected temporary/test commit message pattern: $pattern"
    validation_errors=$((validation_errors + 1))
  fi
done

# 9. Check for merge commit messages (usually auto-generated)
if echo "$commit_msg" | grep -q "^Merge "; then
  log_info "Merge commit detected - validation relaxed"
  validation_errors=0  # Reset errors for merge commits
fi

# 10. Provide helpful suggestions
log_info "💡 Commit message tips:"
echo "  • Use present tense: 'Add feature' not 'Added feature'"
echo "  • Be descriptive: explain what and why, not just how"
echo "  • Keep first line under 72 characters"
echo "  • Reference issues when applicable (#123)"
echo "  • Use conventional commits for consistency"

# Final result
echo "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

if [ $validation_errors -eq 0 ]; then
  log_success "Commit message validation passed! 🎉"
  log_header "Message approved for the family project! 👨‍👩‍👧‍👦"
  exit 0
else
  log_error "$validation_errors validation error(s) found"
  log_header "Please improve your commit message"
  echo ""
  log_info "💡 Quick fixes:"
  echo "  • Ensure message starts with capital letter"
  echo "  • Make message descriptive (min 10 chars)"
  echo "  • Use family-friendly language"
  echo "  • Avoid temporary commit messages"
  echo ""
  echo "Edit your commit message with: git commit --amend"
  exit 1
fi 