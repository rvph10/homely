# 🏠 Homely Family Management System - Environment Configuration
# =============================================================
# Copy this file to .env and configure with your actual values
# Never commit .env to version control - it contains sensitive data

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/homely"
DATABASE_SCHEMA="public"

# Server Configuration
PORT=3001
NODE_ENV="development"
API_BASE_URL="http://localhost:3001"
WEB_BASE_URL="http://localhost:3000"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-here-change-me"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-here"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Family Settings
FAMILY_NAME="Your Family Name"
TIMEZONE="America/New_York"
DEFAULT_LOCALE="en-US"

# External Services (Optional)
# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@yourdomain.com"

# SMS Notifications (Optional)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Cloud Storage (Optional)
# For family photos and documents
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-family-bucket"

# Google Calendar Integration (Optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"

# Weather API (Optional)
WEATHER_API_KEY="your-openweathermap-api-key"
DEFAULT_LOCATION="New York, NY"

# IoT Device Integration (Optional)
# For smart home integration
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME="your-mqtt-username"
MQTT_PASSWORD="your-mqtt-password"

# Raspberry Pi Specific
# Hardware configuration for Pi deployment
GPIO_ENABLED="true"
CAMERA_ENABLED="false"
SENSOR_POLLING_INTERVAL="30000"

# Security & Privacy
# Session and security settings
SESSION_SECRET="your-session-secret-here"
COOKIE_SECURE="false"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs/homely.log"
LOG_MAX_FILES="5"
LOG_MAX_SIZE="10m"

# Feature Flags
ENABLE_LOCATION_TRACKING="false"
ENABLE_VOICE_COMMANDS="false"
ENABLE_ANALYTICS="false"
ENABLE_PUSH_NOTIFICATIONS="true"

# Development Only
DEBUG="homely:*"
MOCK_EXTERNAL_APIS="false" 